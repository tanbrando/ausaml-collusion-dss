# Backend Server
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./aml_dss.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Engine Toggle
# true  = Chạy Contract Mock Engine (khởi động < 1s, dùng để Việt code M3 & M4 song song)
# false = Chạy Real PyTorch GNN Engine (Tấn bật sau khi hoàn tất M1 & nạp checkpoints .pt)
USE_MOCK_ENGINE=true
DEFAULT_MODEL_ID=hybrid_v3_best
DEVICE=cpu

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
